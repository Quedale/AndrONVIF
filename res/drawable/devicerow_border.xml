<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Define the border color and width (thickness) -->
    <stroke
        android:width="@dimen/borderSize"
        android:color="?attr/colorPrimary" /> <!-- Example: black color -->

    <!-- Define the background color of the view (optional, can be transparent) -->
    <solid
        android:color="?android:attr/colorBackground" /> <!-- Example: white color -->

    <!-- Define rounded corners (optional) -->
    <corners
        android:radius="@dimen/borderRadius" />
</shape>
