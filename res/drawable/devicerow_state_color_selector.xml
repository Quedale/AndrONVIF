<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Color when the view is pressed (e.g., clicked) -->
    <item android:state_pressed="true" android:color="?android:attr/colorBackground" />

    <!-- Default color when none of the above states match -->
    <item android:color="?attr/colorPrimary" />
</selector>