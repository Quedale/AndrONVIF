<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/DeviceListFragment">

    <fragment
        android:id="@+id/PlayerFragment"
        android:name="net.quedale.andronvif.player.PlayerFragment"
        android:label="@string/player_fragment_label"
        tools:layout="@layout/player_fragment" >
        <argument
            android:name="device"
            app:argType="net.quedale.andronvif.jni.AndrONVIFDevice"
            app:nullable="false" />
    </fragment>

    <fragment
        android:id="@+id/DeviceListFragment"
        android:name="net.quedale.andronvif.list.DeviceListFragment"
        android:label="@string/device_list_fragment_label"
        tools:layout="@layout/device_list_fragment" >
        <action
            android:id="@+id/action_DeviceListFragment_to_PlayerFragment"
            app:destination="@id/PlayerFragment" />
        <action
            android:id="@+id/action_DeviceListFragment_to_DeviceDiscoveryFragment"
            app:destination="@id/DeviceDiscoveryFragment" />
    </fragment>
    <fragment
        android:id="@+id/DeviceDiscoveryFragment"
        android:name="net.quedale.andronvif.discovery.DiscoveryFragment"
        android:label="@string/device_discovery_fragment_label"
        tools:layout="@layout/device_discovery_fragment" >

        <action
            android:id="@+id/action_DeviceDiscoveryFragment_to_AddDeviceFragment"
            app:destination="@id/AddDeviceFragment" />
    </fragment>

    <fragment
        android:id="@+id/AddDeviceFragment"
        android:name="net.quedale.andronvif.adddevice.AddDeviceFragment"
        android:label="@string/add_device_fragment_label"
        tools:layout="@layout/add_device_fragment" >
        <argument
            android:name="device"
            app:argType="net.quedale.andronvif.jni.AndrONVIFDevice"
            app:nullable="true"
            android:defaultValue="@null" />

        <action
            android:id="@+id/action_AddDeviceFragment_to_PlayerFragment"
            app:destination="@id/PlayerFragment"
            app:launchSingleTop="true"
            app:popUpTo="@+id/DeviceListFragment"
            app:popUpToInclusive="false"/>
    </fragment>
</navigation>