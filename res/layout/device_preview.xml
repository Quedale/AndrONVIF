<?xml version="1.0" encoding="utf-8"?>
<net.quedale.andronvif.list.DevicePreview
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/devicepreview"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/devicerow_state_border_selector"
    android:padding="10dp"
    android:layout_margin="1dp">
    <FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/snapshotPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="A onvif snapshot preview"
            android:adjustViewBounds="true"
            android:scaleType="fitXY" />
        <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/devicerow_state_border_selector"
            android:alpha="0.5"
            android:padding="8dp">
            <TextView xmlns:android="http://schemas.android.com/apk/res/android"
                android:id="@+id/device_name"
                android:textColor="@drawable/devicerow_state_color_selector"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:singleLine="true"
                android:ellipsize="end"
                android:textSize="@dimen/previewTitleSize"/>
            <TextView xmlns:android="http://schemas.android.com/apk/res/android"
                android:id="@+id/device_hw"
                android:textColor="@drawable/devicerow_state_color_selector"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:singleLine="true"
                android:ellipsize="end"
                android:textSize="@dimen/previewFontSize" />
            <TextView xmlns:android="http://schemas.android.com/apk/res/android"
                android:id="@+id/device_location"
                android:textColor="@drawable/devicerow_state_color_selector"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:singleLine="true"
                android:ellipsize="end"
                android:textSize="@dimen/previewFontSize"/>
        </LinearLayout>
    </FrameLayout>
</net.quedale.andronvif.list.DevicePreview>